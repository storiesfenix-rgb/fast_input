# Базовый образ: берем легкую и стабильную версию Node.js на базе Alpine Linux
FROM node:20-alpine

# Указываем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы package.json, чтобы установить зависимости
COPY package*.json ./

# Устанавливаем зависимости (пока их нет, но команда обязательна для будущего)
RUN npm install

# Копируем весь остальной код бэкенда (в нашем случае server.js)
COPY . .

# Открываем порт 5000, который слушает наш Node.js сервер
EXPOSE 5000

# Команда для запуска приложения при старте контейнера
CMD ["npm", "start"]
